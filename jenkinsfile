pipeline {
  agent any

  environment {
    DOCKER_IMAGE = "azmatahmed/devops-shop"
  }

  stages {

    stage('Checkout') {
      steps { checkout scm }
    }

    stage('Build Docker Image') {
      steps {
        sh 'docker build -t azmatahmed/devops-shop:$BUILD_NUMBER .
'
      }
    }

    stage('Push to DockerHub') {
      steps {
        withDockerRegistry([credentialsId: 'dockerhub-creds', url: '']) {
          sh 'docker push azmatahmed/devops-shop:$BUILD_NUMBER'
        }
      }
    }
  }
}
